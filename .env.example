APP_ORIGIN=https://app.natheegroup2025.com
OWNER_PIN_CREDENTIAL=v1$pbkdf2-sha256$210000$replace_me_salt$replace_me_hash
OWNER_SESSION_SECRET=replace_me_32_random_bytes_base64url
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
NEXT_PUBLIC_TURNSTILE_SITE_KEY=turnstile_site_key_replace_me
TURNSTILE_SECRET_KEY=turnstile_secret_key_replace_me
# The application origin. The public marketing website stays on the apex
# https://natheegroup2025.com and is never used as APP_ORIGIN.
#
# Owner CMS PIN login. Both values are secrets and neither has a default; the
# placeholders above are not credentials and the runtime refuses them. Generate
# a real pair without ever typing the PIN into a shell:
#   npm run owner:pin
# Replacing OWNER_PIN_CREDENTIAL changes the PIN and invalidates every session
# issued under the old one. The Owner address is fixed in the server source and
# is never read from a request, so there is no variable for it here.
#
# Supabase stays optional. Setting neither pair is a runtime with no way in;
# either complete pair is enough, and `npm run verify:env` names which mode it
# would run in.
# Supabase Auth production Site URL: https://app.natheegroup2025.com
# Supabase Auth production callback: https://app.natheegroup2025.com/auth/callback
