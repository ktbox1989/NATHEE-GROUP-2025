DirectoryIndex index.html
Options -Indexes

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep one canonical public hostname. HTTPS is already enforced upstream.
  RewriteCond %{HTTP_HOST} ^www\.natheegroup2025\.com$ [NC]
  RewriteRule ^ https://natheegroup2025.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# BEGIN NATHEE LOGIN REDIRECT
# NATHEE_LOGIN_REDIRECT_STATE=INACTIVE
# NATHEE_LOGIN_REDIRECT_TARGET=https://app.natheegroup2025.com/login
#
# The public /login/ page is served from this site while the application
# runtime is not accepted. Managed by scripts/set-login-redirect.mjs;
# do not edit by hand.
# END NATHEE LOGIN REDIRECT

# BEGIN NATHEE PUBLIC APEX MAPPING
# NATHEE_PUBLIC_APEX_MAPPING_STATE=INACTIVE
# NATHEE_PUBLIC_APEX_MAPPING_TARGET=https://app.natheegroup2025.com
#
# Managed by scripts/set-public-apex-mapping.mjs; do not edit by hand.
#
# The application is not proxied from the apex. /assets/media/ and
# /sitemap.xml are served by this static release exactly as before, and
# CMS-managed media is not reachable from the public site.
# END NATHEE PUBLIC APEX MAPPING

<IfModule mod_mime.c>
  # Shared hosting does not map this extension by default, and a manifest
  # served as text/plain is ignored by the browser.
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(?:login|auth|app|api)(?:/|$)" private_route
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"

  # Short HSTS during the first verified static release. Raise only after a
  # separate acceptance period; do not add includeSubDomains without review.
  Header always set Strict-Transport-Security "max-age=300"

  # Pages and the surfaces derived from them. A publish regenerates the sitemap
  # and robots.txt, so both must revalidate for the same reason a page does:
  # with no Cache-Control at all a cache invents its own freshness lifetime, and
  # a stale sitemap keeps advertising withdrawn URLs and hides the new ones.
  <FilesMatch "\.(?:html?|xml|txt)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "^(?:login-status|404)\.html$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>

  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=private_route

  # Static assets in this document root only. A proxied /assets/media/ variant
  # already carries the application's own Cache-Control - bounded rather than
  # immutable, so an item withdrawn from PUBLIC stops being served within a
  # knowable window - and replacing it here would silently extend that window.
  <FilesMatch "\.(?:css|js|json|webmanifest|svg|avif|webp|jpe?g|png)$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate" "expr=%{REQUEST_URI} !~ m#^/assets/media/#"
  </FilesMatch>
</IfModule>
